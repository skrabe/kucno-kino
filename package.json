{
  "name": "kucno-kino",
  "version": "1.0.0",
  "private": true,
  "description": "Stremio add-on: live Netflix-style rows with Croatian/Bosnian/Serbian titles and descriptions from TMDB.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
