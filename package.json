    "build:logo": "node scripts/logo.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
